{
  "name": "portfolio-hector-creative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:test": "pnpm check && pnpm build",
    "agent:story": "omp --model @story --append-system-prompt \"Actúa como coordinador del ciclo ágil TDD según docs/flujo-agil-tdd.md; despacha gherkin→tdd→harden como subagentes internos vía task.\"",
    "commit": "omp commit",
    "cleanse": "omp cleanse --all -t",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:complexity": "eslintcc \"src/**/*.ts\" \"src/**/*.js\" --rules complexity --max-rank A",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "astro": "^7.2.7",
    "gsap": "^3.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^18.3.0",
    "eslintcc": "^0.8.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
