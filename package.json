{
  "name": "portfolio-hector-creative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agents:sync": "node scripts/sincronizar-agentes.mjs",
    "agents:setup": "OPENSPEC_TELEMETRY=0 openspec init --tools codex,claude,opencode",
    "agents:update": "OPENSPEC_TELEMETRY=0 openspec update --force",
    "agent:orchestrator": "codex --model gpt-5.6-luna -c model_reasoning_effort=\"xhigh\"",
    "agent:spec": "codex --model gpt-6-astra -c model_reasoning_effort=\"medium\"",
    "agent:apply": "claude --model sonnet",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^7.2.7",
    "gsap": "^3.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
