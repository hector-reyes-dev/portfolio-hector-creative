---
import BaseLayout from '@layouts/BaseLayout.astro';
import PortfolioTemplate from '../components/templates/PortfolioTemplate.astro';
---

<BaseLayout
  title="Héctor Reyes — Ingeniero de Producto"
  description="Portafolio y servicios de Héctor Reyes: diseño de interfaz, desarrollo de aplicaciones web y sitios de principio a fin."
>
  <Fragment slot="head">
    <link rel="icon" href="/assets/branding/logo.png" type="image/png" />
  </Fragment>

  <PortfolioTemplate />

  <script>
    import { initDock } from '@features/dock/init';
    import { initReveals } from '@features/reveal/init';
    import { initCaseWindow } from '@features/case-window/init';
    import { initMagneticHover } from '@features/magnetic-hover/init';
    import { initSpotlight } from '@features/spotlight/init';
    import { initSwitchToggle } from '@features/switch-toggle/init';
    import { initButtonPress } from '@features/button-press/init';
    import { initThemeSwitcher } from '@features/theme-switcher/init';
    import { initProjectShowcase } from '@features/projects/init';
    import { initBlog } from '@features/blog/init';

    initThemeSwitcher();
    initDock();
    initReveals();
    initCaseWindow();
    initMagneticHover();
    initSpotlight();
    initSwitchToggle();
    initButtonPress();
    initProjectShowcase();
    initBlog();
  </script>
</BaseLayout>
