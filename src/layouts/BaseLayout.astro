---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portafolio profesional construido con Astro, Tailwind CSS y GSAP.'
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="bg-surface text-text antialiased">
    <div class="min-h-screen">
      <slot />
    </div>
  </body>
</html>
