---
interface Props {
  label: string;
  caption: string;
  edge?: boolean;
}

const { label, caption, edge = false } = Astro.props;
---

<article class="demo" data-reveal>
  <div class={`demo__stage${edge ? ' demo__stage--edge' : ''}`}>
    <slot />
  </div>
  {/*
    El detalle se presenta sólo con su demostración: ni el nombre ni la nota se pintan como
    contenedor visible. Se conservan como texto para lectores de pantalla, que no reciben el
    control en contexto sin ellos.
  */}
  <p class="sr-only">{label}. {caption}</p>
</article>
