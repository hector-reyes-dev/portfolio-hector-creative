---
import type { Reason } from '../../types/site';
import Icon from '@atoms/Icon.astro';

interface Props {
  reason: Reason;
}

const { reason } = Astro.props;
---

<div class="reason" data-reveal>
  <span class="reason__icon"><Icon id="i-star" /></span>
  <div>
    <h3>{reason.title}</h3>
    <p>{reason.text}</p>
  </div>
</div>
