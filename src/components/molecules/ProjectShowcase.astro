---
import type { Project } from '../../types/site';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const showcase = projects.filter(Boolean);
const initial = showcase[0];
const tagLine = (project: Project): string => project.tags.join(' · ');
---

{initial && (
  <div
    class="project-showcase"
    data-project-showcase
    data-reduced-motion="false"
    style={`--showcase-duration: 420ms; --showcase-count: ${showcase.length}`}
  >
    <div
      class="project-showcase__panel"
      data-project-panel
      aria-live="polite"
      aria-atomic="true"
    >
      <div class="project-showcase__copy">
        {/*
          El bloque de texto mide el contenido real y no un número de líneas adivinado. La capa de
          medida (`project-showcase__measure`, invisible y fuera del árbol accesible) apila la
          composición completa de cada proyecto —etiquetas, título y descripción con el mismo
          espaciado— en una sola celda, y la capa viva comparte esa celda alineada arriba. Así el
          bloque mide la variante más alta al ancho vigente en lugar de la suma de máximos: el
          marco de imagen y los selectores no se mueven al cambiar de proyecto, y el hueco que
          dejan las variantes más largas se acumula al final del bloque en vez de intercalarse
          entre las líneas del proyecto seleccionado. Nada se recorta ni se elipsa.
        */}
        <div class="project-showcase__measure" aria-hidden="true">
          {showcase.map((project) => (
            <div class="project-showcase__copy-block">
              <p class="project-showcase__tags sr-only">{tagLine(project)}</p>
              <h4 class="project-showcase__title">{project.full}</h4>
              <p class="project-showcase__description">{project.desc}</p>
            </div>
          ))}
        </div>
        <div class="project-showcase__copy-block project-showcase__live">
          {/*
            La línea de etiquetas ya no se pinta como eyebrow: el título del proyecto abre la
            ficha. Se conserva como texto para lectores de pantalla porque describe el proyecto
            seleccionado y porque el panel se repinta completo o no se repinta (`init.ts` exige
            todas sus partes). Las dos capas —medida y viva— llevan la misma composición para que
            sigan midiendo lo mismo.
          */}
          <p class="project-showcase__tags sr-only" data-project-tags>{tagLine(initial)}</p>
          <h4 class="project-showcase__title" data-project-title>{initial.full}</h4>
          <p class="project-showcase__description" data-project-description>{initial.desc}</p>
        </div>
      </div>
      <div class={`project-showcase__media card__media--${initial.slug}`} data-project-media>
        <img
          data-project-image
          src={`/${initial.image}`}
          alt={initial.full}
          width={initial.w}
          height={initial.h}
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <div class="project-showcase__selectors" role="group" aria-label="Seleccionar proyecto">
      {showcase.map((project, index) => (
        <button
          class="project-showcase__selector"
          type="button"
          data-project-trigger
          data-project-index={index}
          data-project-image={`/${project.image}`}
          data-project-full={project.full}
          data-project-desc={project.desc}
          data-project-tags={project.tags.join(' · ')}
          data-project-width={project.w}
          data-project-height={project.h}
          data-project-slug={project.slug}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-label={project.full}
          style={`background-image: url("/${project.image}")`}
        ></button>
      ))}
    </div>
  </div>
)}
