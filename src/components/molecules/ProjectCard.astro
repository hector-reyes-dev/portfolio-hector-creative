---
import Icon from '@atoms/Icon.astro';
import type { Project } from '../../types/site';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: extraClass } = Astro.props;
const className = `card${extraClass ? ` ${extraClass}` : ''}`;
const href = project.documented ? `#/caso/${project.slug}` : project.url;
const mediaClass = `card__media card__media--${project.slug}`;
const iconForTag = (tag: string): string => {
  const normalized = tag.toLowerCase();
  if (normalized.includes('dise')) return 'i-pen';
  if (normalized.includes('front') || normalized.includes('back') || normalized.includes('desarroll')) return 'i-code';
  if (normalized.includes('app') || normalized.includes('mobile')) return 'i-cart';
  return 'i-star';
};
---

<a
  class={className}
  data-reveal
  href={href}
  target={project.documented ? undefined : '_blank'}
  rel={project.documented ? undefined : 'noopener'}
>
    <div class={mediaClass} role="img" aria-label={project.full}>
      <div class="card__media-icons" aria-label={`Tipo de proyecto: ${project.tags.join(', ')}`}>
        {project.tags.map((tag) => (
          <span class="card__type" title={tag}>
            <Icon id={iconForTag(tag)} />
            <span class="sr-only">{tag}</span>
          </span>
        ))}
      </div>
    </div>
    <div class="card__body">
      <h3 class="card__title">
        {project.full}
        {!project.documented && <Icon id="i-external" />}
        {!project.documented && <span class="sr-only">(se abre en otra pestaña)</span>}
      </h3>
      <p class="card__desc">{project.desc}</p>
    </div>
</a>
