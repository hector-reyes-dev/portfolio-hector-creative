---
interface Props {
  title: string;
  lead?: string;
  level?: 2 | 3;
}

const { title, lead, level = 2 } = Astro.props;
---

<header class:list={['section-head', { 'section-head--subsection': level === 3 }]} data-reveal>
  {level === 3 ? <h3 class="section-title">{title}</h3> : <h2 class="section-title">{title}</h2>}
  {lead && <p class="lead">{lead}</p>}
</header>
