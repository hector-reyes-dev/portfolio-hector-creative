---
import SectionHeader from '@molecules/SectionHeader.astro';
import ReasonItem from '@molecules/ReasonItem.astro';
import TestimonialItem from '@molecules/TestimonialItem.astro';
import type { Reason, Testimonial } from '../../types/site';

interface Props {
  reasons: Reason[];
  testimonials: Testimonial[];
}

const { reasons, testimonials } = Astro.props;
---

<section class="section" id="por-que">
  <div class="container">
    <SectionHeader title="Por qué trabajar conmigo" />
    <div class="reasons">
      {reasons.map((reason) => (
        <ReasonItem reason={reason} />
      ))}
    </div>
    <div class="subsection">
      <SectionHeader title="Testimonios" level={3} />
      <div class="testimonials">
        {testimonials.map((testimonial) => (
          <TestimonialItem testimonial={testimonial} />
        ))}
      </div>
    </div>
  </div>
</section>
