---
import Button from '@atoms/Button.astro';
import Icon from '@atoms/Icon.astro';
import SectionHeader from '@molecules/SectionHeader.astro';
import ServiceCard from '@molecules/ServiceCard.astro';
import type { Service } from '../../types/site';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<section class="section" id="servicios">
  <div class="container">
    <SectionHeader
      title="Cómo puedo ayudarte"
      lead="Tres formas de aportar a tu producto. Elige la que necesites o escríbeme y lo vemos juntos."
    />
    <div class="service-grid">
      {services.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>
    <Button variant="accent" href="#contacto">Hablemos de servicios <Icon id="i-handshake" /></Button>
  </div>
</section>
