---
import SectionHeader from '@molecules/SectionHeader.astro';
import ProjectCard from '@molecules/ProjectCard.astro';
import type { Project } from '../../types/site';

interface Props {
  cases: Project[];
}

const { cases } = Astro.props;
---

<section class="section" id="proyectos">
  <div class="container">
    <SectionHeader
      title="Proyectos"
      lead="Tres casos con las mismas seis preguntas: problema, restricciones, descartes, decisión, resultado y qué haría distinto. La curaduría también es parte del trabajo."
    />
    <div class="card-grid card-grid--trabajo">
      {cases.map((project) => (
        <ProjectCard project={project} class="card--case" />
      ))}
    </div>
  </div>
</section>
