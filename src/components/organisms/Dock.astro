---
import DockItem from '@molecules/DockItem.astro';
import ThemeToggle from '@atoms/ThemeToggle.astro';
import type { DockSection } from '../../types/site';

interface Props {
  sections: DockSection[];
}

const { sections } = Astro.props;
---

<nav class="dock" aria-label="Secciones del sitio">
  {sections.map((section) => (
    <DockItem section={section} />
  ))}
  <ThemeToggle />
</nav>
