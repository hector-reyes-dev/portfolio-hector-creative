---
import SectionHeader from '@molecules/SectionHeader.astro';
import ProjectShowcase from '@molecules/ProjectShowcase.astro';
import type { Project } from '../../types/site';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const showcase = projects.slice(0, 6);
---

<section class="section" id="trabajo">
  <div class="container">
    <SectionHeader
      title="Casos documentados"
      lead="Seis proyectos reales, de aplicaciones a sitios completos. Los documentados abren su caso; el resto enlaza a su ficha."
    />
    <ProjectShowcase projects={showcase} />
  </div>
</section>
