---
import ExperienceItem from '@molecules/ExperienceItem.astro';
import type { Experience } from '../../types/site';

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section class="section experience-section" id="experiencia">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 class="section-title">Experiencia</h2>
    </header>
    <div class="experience-list">
      {experiences.map((experience) => <ExperienceItem experience={experience} />)}
      <div class="experience-item experience-item--placeholder" data-reveal>
        <p class="experience-item__period">Próximamente</p>
        <p class="experience-item__copy">Más experiencias por añadir</p>
      </div>
    </div>
  </div>
</section>
