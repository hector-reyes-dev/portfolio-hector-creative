---
import Button from '@atoms/Button.astro';
import Icon from '@atoms/Icon.astro';
import HeroPortrait from '@molecules/HeroPortrait.astro';
import type { HeroContent } from '../../types/site';

interface Props {
  hero: HeroContent;
}

const { hero } = Astro.props;
---

<section class="hero" id="inicio">
  <div class="container">
    <HeroPortrait />
    <h1 class="hero__name">Héctor Reyes</h1>
    <p class="hero__role">{hero.role}</p>
    <div class="hero__bio">
      {hero.bio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <Button href="#proyectos" variant="accent" class="hero__cta">
      Ver proyectos <Icon id="i-arrow" />
    </Button>
  </div>
</section>
