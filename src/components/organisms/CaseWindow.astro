---
import Icon from '@atoms/Icon.astro';
import IconTile from '@atoms/IconTile.astro';
import Chip from '@atoms/Chip.astro';
import QAItem from '@molecules/QAItem.astro';
import type { CaseQuestion, CaseStudy, Project } from '../../types/site';

interface Props {
  documentedProjects: Project[];
  cases: Record<string, CaseStudy>;
  caseQuestions: CaseQuestion[];
}

const { documentedProjects, cases, caseQuestions } = Astro.props;
---

<section class="window" id="window" role="dialog" aria-modal="true" aria-labelledby="windowTitle" tabindex="-1" hidden>
  <header class="window__head">
    <span class="window__icon"><Icon id="i-trabajo" /></span>
    <h2 class="window__title" id="windowTitle" tabindex="-1">Trabajo</h2>
    <button class="window__close" id="windowClose" type="button" aria-label="Cerrar ventana">
      <Icon id="i-close" />
    </button>
  </header>
  <div class="window__body" id="windowBody"></div>
</section>

{documentedProjects.map((project) => {
  const caseStudy = cases[project.slug];
  return (
    <template data-case-template={project.slug}>
      <article class="case">
        <header class="case__head">
          <div class="case__top">
            <IconTile icon={project.icon} />
            <div class="od-fill">
              <p class="case__num">#{project.num}</p>
              <h3 class="case__title">{project.full}</h3>
            </div>
          </div>
          <div class="chips">
            {project.tags.map((tag) => (
              <Chip>{tag}</Chip>
            ))}
          </div>
          <figure class={`case__image case__image--${project.slug}`} role="img" aria-label={project.full}></figure>
        </header>
        <div class="qa-grid">
          {caseQuestions.map(([key, label]) => (
            <QAItem label={label} value={caseStudy ? caseStudy[key] : null} />
          ))}
        </div>
      </article>
    </template>
  );
})}
