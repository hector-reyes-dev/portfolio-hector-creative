---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'accent' | 'pill';
  target?: string;
  rel?: string;
  id?: string;
  class?: string;
  ariaLabel?: string;
}

const { href, type = 'button', variant = 'pill', target, rel, id, class: extraClass, ariaLabel, ...rest } = Astro.props;
const className = `btn btn--${variant}${extraClass ? ` ${extraClass}` : ''}`;
---

{
  href ? (
    <a id={id} href={href} class={className} target={target} rel={rel} aria-label={ariaLabel} {...rest}>
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={className} aria-label={ariaLabel} {...rest}>
      <slot />
    </button>
  )
}
