---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  disabled = false,
  ariaLabel
} = Astro.props;

const baseClass =
  'button-focus transition-standard inline-flex items-center justify-center gap-2 rounded-[var(--radius-md)] border font-medium tracking-tight';

const variantClass = {
  primary:
    'border-transparent bg-accent px-5 text-white shadow-soft hover:-translate-y-0.5 hover:shadow-lg',
  secondary:
    'border-border bg-elevated text-text hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent',
  ghost:
    'border-transparent bg-transparent text-text hover:bg-elevated/80 hover:text-accent'
}[variant];

const sizeClass = {
  sm: 'min-h-10 px-4 text-sm',
  md: 'min-h-11 px-5 text-sm',
  lg: 'min-h-12 px-6 text-base'
}[size];

const stateClass = disabled ? 'pointer-events-none opacity-60' : '';
const className = `${baseClass} ${variantClass} ${sizeClass} ${stateClass}`;
---

{
  href ? (
    <a href={href} class={className} aria-label={ariaLabel} aria-disabled={disabled}>
      <slot />
    </a>
  ) : (
    <button type={type} class={className} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
}
