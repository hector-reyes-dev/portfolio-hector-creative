                  "name": "Hero Paragraph",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Me importan el detalle y el rendimiento. Que una interfaz se sienta bien al usarla, no solo al mirarla. Mi trabajo pasa por e-commerce, aplicaciones web y sistemas de diseño.",
                  "lineHeight": 1.72,
                  "fontFamily": "$font-body",
                  "fontSize": 16.5,
                  "fontWeight": "normal"
